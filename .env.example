# Nebius AI Studio / Token Factory Credentials
# Get your API key from https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius OpenAI-compatible Endpoint
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/

# Primary NVIDIA Model (Hosted on Nebius Token Factory)
# Options include:
# - nvidia/nemotron-3-super-120b
# - nvidia/nemotron-3-nano-30b
# - meta-llama/Meta-Llama-3.1-70B-Instruct
NEBIUS_MODEL=nvidia/nemotron-3-super-120b
NEBIUS_FALLBACK_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Execution mode: true for deterministic simulation when API key is unset
MOCK_MODE=false

# Port configuration
PORT=3005
