# Nebius Token Factory credentials
# Get your API key from https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius OpenAI-compatible Endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Primary NVIDIA Model (Hosted on Nebius Token Factory)
# Verified available on 2026-10-28; model availability can change.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FALLBACK_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Keep rehearsals in deterministic simulation; change only for an approved live run.
MOCK_MODE=true
ENABLE_LIVE_REPAIR=false

# Port configuration
PORT=3005
